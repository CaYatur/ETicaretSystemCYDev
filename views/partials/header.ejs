<% if (site.announcement) { %>
<div class="announcement-bar" id="announcementBar">
  <div class="container ann-inner">
    <span class="ann-text"><%= site.announcement %></span>
    <% if (site.announcement_cta) { %>
    <a href="<%= site.announcement_url || '/shop' %>" class="ann-cta"><%= site.announcement_cta %></a>
    <% } %>
    <button onclick="this.closest('.announcement-bar').remove()" class="ann-close" aria-label="Kapat">&times;</button>
  </div>
</div>
<% } %>

<header class="site-header">
  <!-- Row 1: Logo + Search + Actions -->
  <div class="header-top">
    <div class="container">
      <div class="header-inner">

        <!-- Logo -->
        <a href="/" class="header-logo">
          <% if (site.logo) { %>
          <img src="<%= site.logo %>" alt="<%= site.name %>" loading="lazy">
          <% } else { %>
          <img src="/public/branding/logo.svg" alt="<%= site.name %>" class="logo-default" loading="lazy">
          <% } %>
        </a>

        <!-- Spacer for centering -->
        <div class="header-spacer-left"></div>

        <!-- Search Bar -->
        <% if (site.shop_enabled) { %>
        <form action="/shop" method="GET" class="header-search" role="search">
          <input type="search" name="search" placeholder="Ürün, kategori veya marka ara..." class="header-search-input" autocomplete="off">
          <button type="submit" class="header-search-btn" aria-label="Ara">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </button>
        </form>
        <% } %>

        <!-- Spacer for centering -->
        <div class="header-spacer-right"></div>

        <!-- Actions -->
        <div class="header-actions">
          <% if (site.shop_enabled) { %>
          <a href="/api/cart/page" class="header-cart" title="Sepetim">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.98-1.71l1.6-9.29H6"/></svg>
            <span class="cart-badge" id="cartBadge" style="<%= cartCount > 0 ? '' : 'display:none' %>"><%= cartCount || '' %></span>
          </a>
          <% } %>

          <% if (user) { %>
          <div class="nav-dropdown">
            <button class="header-user-btn">
              <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="" class="user-avatar-sm" loading="lazy">
              <% } else { %>
              <span class="user-initial"><%= user.display_name.charAt(0).toUpperCase() %></span>
              <% } %>
              <span class="user-name-label"><%= user.display_name %></span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="dropdown-menu dropdown-right">
              <a href="/account" class="dropdown-item">Hesabım</a>
              <a href="/account/orders" class="dropdown-item">Siparişlerim</a>
              <a href="/account/addresses" class="dropdown-item">Adreslerim</a>
              <a href="/account/billing" class="dropdown-item">Fatura Bilgilerim</a>
              <% if (user.role === 'admin' || user.role === 'editor' || user.role === 'moderator') { %>
              <hr class="dropdown-divider">
              <a href="/admin" class="dropdown-item">Yönetim Paneli</a>
              <% } %>
              <hr class="dropdown-divider">
              <form action="/auth/logout" method="POST" style="margin:0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item dropdown-btn">Çıkış Yap</button>
              </form>
            </div>
          </div>
          <% } else { %>
          <a href="/auth/login" class="btn btn-sm btn-outline">Giriş</a>
          <a href="/auth/register" class="btn btn-sm btn-primary">Kayıt Ol</a>
          <% } %>

          <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menü">
            <span></span><span></span><span></span>
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- Row 2: Navigation Bar -->
  <nav class="header-nav-bar">
    <div class="container">
      <ul class="header-nav">
        <li><a href="/" class="nav-bar-link <%= currentPath === '/' ? 'active' : '' %>">Ana Sayfa</a></li>
        <% if (site.shop_enabled) { %>
        <li class="nav-bar-dropdown">
          <a href="/shop" class="nav-bar-link <%= currentPath.startsWith('/shop') ? 'active' : '' %>">
            <%= site.shop_name %>
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
          <% if (shopCategories.length > 0) { %>
          <div class="nav-bar-dropdown-menu">
            <% shopCategories.forEach(c => { %>
            <a href="/shop?category=<%= c.slug %>" class="dropdown-item">
              <% if (c.icon) { %><span class="dropdown-icon"><%= c.icon %></span><% } %>
              <%= c.name %>
            </a>
            <% }) %>
          </div>
          <% } %>
        </li>
        <% } %>
        <% if (site.blog_enabled) { %>
        <li class="nav-bar-dropdown">
          <a href="/blog" class="nav-bar-link <%= currentPath.startsWith('/blog') ? 'active' : '' %>">
            <%= site.blog_name %>
            <% if (blogCategories.length > 0) { %>
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            <% } %>
          </a>
          <% if (blogCategories.length > 0) { %>
          <div class="nav-bar-dropdown-menu">
            <% blogCategories.forEach(c => { %>
            <a href="/blog?category=<%= c.slug %>" class="dropdown-item"><%= c.name %></a>
            <% }) %>
          </div>
          <% } %>
        </li>
        <% } %>
        <li><a href="/contact" class="nav-bar-link <%= currentPath === '/contact' ? 'active' : '' %>">İletişim</a></li>
      </ul>
    </div>
  </nav>
</header>

<!-- Mobile Navigation Overlay -->
<div class="mobile-nav" id="mobileNav" aria-hidden="true">
  <div class="mobile-nav-inner">
    <a href="/" class="mobile-nav-link">Ana Sayfa</a>
    <% if (site.shop_enabled) { %>
    <a href="/shop" class="mobile-nav-link"><%= site.shop_name %></a>
    <% if (shopCategories.length > 0) { %>
      <% shopCategories.forEach(c => { %>
      <a href="/shop?category=<%= c.slug %>" class="mobile-nav-link mobile-nav-sub">
        <% if (c.icon) { %><span><%= c.icon %></span><% } %>
        <%= c.name %>
      </a>
      <% }) %>
    <% } %>
    <% } %>
    <% if (site.blog_enabled) { %>
    <a href="/blog" class="mobile-nav-link"><%= site.blog_name %></a>
    <% } %>
    <a href="/contact" class="mobile-nav-link">İletişim</a>
    <div class="mobile-nav-actions">
      <% if (user) { %>
      <a href="/account" class="btn btn-outline btn-block">Hesabım</a>
      <a href="/account/orders" class="btn btn-ghost btn-block">Siparişlerim</a>
      <form action="/auth/logout" method="POST" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-ghost btn-block">Çıkış Yap</button>
      </form>
      <% } else { %>
      <a href="/auth/login" class="btn btn-outline btn-block">Giriş Yap</a>
      <a href="/auth/register" class="btn btn-primary btn-block">Kayıt Ol</a>
      <% } %>
    </div>
  </div>
</div>
