<% layout('layouts/main') %>

<div class="auth-page">
  <div class="auth-card auth-card-sm">
    <h1>Şifremi Unuttum</h1>
    <p class="auth-subtitle">E-posta adresinize şifre sıfırlama bağlantısı göndereceğiz.</p>

    <form action="/auth/forgot-password" method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label">E-posta</label>
        <input type="email" name="email" required class="form-input" placeholder="ornek@email.com" autocomplete="email">
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">Sıfırlama Bağlantısı Gönder</button>
    </form>

    <p class="auth-footer">
      <a href="/auth/login" class="link">&larr; Giriş sayfasına dön</a>
    </p>
  </div>
</div>
