<% layout('layouts/main') %>

<!-- Blog Hero -->
<div class="blog-hero">
  <div class="container">
    <div class="blog-hero-inner">
      <h1 class="blog-hero-title"><%= site.blog_name || 'Blog' %></h1>
      <p class="blog-hero-sub">Güncel yazılar, haberler ve daha fazlası</p>
    </div>
  </div>
</div>

<div class="container page-content">
  <div class="breadcrumb">
    <a href="/">Ana Sayfa</a> &rsaquo; <span>Blog</span>
  </div>

  <div class="blog-layout">
    <!-- Sidebar -->
    <aside class="blog-sidebar">
      <!-- Arama -->
      <div class="blog-widget">
        <h3 class="blog-widget-title">Ara</h3>
        <form action="/blog" method="GET">
          <div class="blog-search-wrap">
            <input type="text" name="search" placeholder="Blog'da ara..." value="<%= currentSearch || '' %>" class="blog-search-input">
            <button type="submit" class="blog-search-btn" aria-label="Ara">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Kategoriler -->
      <div class="blog-widget">
        <h3 class="blog-widget-title">Kategoriler</h3>
        <div class="blog-categories">
          <a href="/blog" class="blog-cat-pill <%= !currentCategory ? 'active' : '' %>">Tümü</a>
          <% blogCategories.forEach(c => { %>
          <a href="/blog?category=<%= c.slug %>" class="blog-cat-pill <%= currentCategory === c.slug ? 'active' : '' %>"><%= c.name %></a>
          <% }) %>
        </div>
      </div>
    </aside>

    <!-- Yazılar -->
    <div class="blog-content">
      <% if (posts.length === 0) { %>
      <div class="blog-empty">
        <div class="blog-empty-icon">
          <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <h3>Henüz yazı yok</h3>
        <p>Bu bölümde henüz yayınlanmış bir yazı bulunmuyor.</p>
      </div>
      <% } else { %>
      <div class="post-grid">
        <% posts.forEach(post => { %>
        <article class="post-card" onclick="window.location.href='/blog/<%= post.slug %>'" style="cursor:pointer">
          <a href="/blog/<%= post.slug %>" class="post-card-image">
            <% if (post.cover_image) { %>
            <img src="<%= post.cover_image %>" alt="<%= post.title %>" loading="lazy">
            <% } else { %>
            <div class="placeholder-image">
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <% } %>
            <div class="post-card-overlay"></div>
            <% if (post.category_name) { %>
            <span class="post-card-cat-badge"><%= post.category_name %></span>
            <% } %>
          </a>
          <div class="post-card-body">
            <h2 class="post-card-title"><a href="/blog/<%= post.slug %>"><%= post.title %></a></h2>
            <% if (post.excerpt) { %>
            <p class="post-excerpt"><%= post.excerpt %></p>
            <% } %>
            <div class="post-card-footer">
              <div class="post-meta">
                <span class="post-author-name"><%= post.author_name || 'Yönetici' %></span>
                <span class="post-meta-sep">·</span>
                <span><%= new Date(post.created_at).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              </div>
              <a href="/blog/<%= post.slug %>" class="post-read-more">Oku →</a>
            </div>
          </div>
        </article>
        <% }) %>
      </div>

      <!-- Sayfalama -->
      <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (currentPage > 1) { %>
        <a href="?page=<%= currentPage - 1 %><%= currentCategory ? '&category=' + currentCategory : '' %><%= currentSearch ? '&search=' + currentSearch : '' %>" class="page-link">&laquo; Önceki</a>
        <% } %>
        <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %><%= currentCategory ? '&category=' + currentCategory : '' %><%= currentSearch ? '&search=' + currentSearch : '' %>" class="page-link <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
        <% } %>
        <% if (currentPage < totalPages) { %>
        <a href="?page=<%= currentPage + 1 %><%= currentCategory ? '&category=' + currentCategory : '' %><%= currentSearch ? '&search=' + currentSearch : '' %>" class="page-link">Sonraki &raquo;</a>
        <% } %>
      </div>
      <% } %>
      <% } %>
    </div>
  </div>
</div>
