<% layout('layouts/main') %>

<div class="container page-content">
  <div class="breadcrumb">
    <a href="/">Ana Sayfa</a> &rsaquo; <a href="/account">Hesabım</a> &rsaquo; <a href="/account/orders">Siparişlerim</a> &rsaquo; <span>#<%= order.order_number %></span>
  </div>

  <div class="order-detail-header">
    <h1>Sipariş #<%= order.order_number %></h1>
    <span class="text-muted"><%= new Date(order.created_at).toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
  </div>

  <div class="order-detail-layout">
    <!-- Sipariş Ürünleri -->
    <div class="card">
      <h2>Sipariş Ürünleri</h2>
      <table class="table">
        <thead>
          <tr>
            <th>Ürün</th>
            <th>Adet</th>
            <th>Fiyat</th>
            <th>Toplam</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
          <tr>
            <td>
              <% if (item.product_id) { %>
              <a href="/shop/<%= item.slug || '' %>"><%= item.title %></a>
              <% } else { %>
              <%= item.title %>
              <% } %>
            </td>
            <td><%= item.quantity %></td>
            <td><%= site.currency_symbol %><%= item.price.toFixed(2) %></td>
            <td><%= site.currency_symbol %><%= (item.price * item.quantity).toFixed(2) %></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3"><strong>Toplam</strong><% if (site.kdv_enabled) { %> <small style="color:#6b7280;font-weight:normal">(KDV Dahil)</small><% } %></td>
            <td><strong><%= site.currency_symbol %><%= order.total.toFixed(2) %></strong></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Durum & Ödeme -->
    <div class="order-detail-side">
      <div class="card">
        <h3>Sipariş Durumu</h3>
        <% 
        const statusMap = {
          pending: { text: 'Beklemede', class: 'warning' },
          paid: { text: 'Ödendi', class: 'info' },
          processing: { text: 'Hazırlanıyor', class: 'info' },
          shipped: { text: 'Kargoda', class: 'primary' },
          delivered: { text: 'Teslim Edildi', class: 'success' },
          cancelled: { text: 'İptal', class: 'danger' }
        };
        const status = statusMap[order.status] || { text: order.status, class: 'secondary' };
        %>
        <span class="badge badge-lg badge-<%= status.class %>"><%= status.text %></span>

        <% if (order.status === 'pending' && order.payment_status !== 'confirmed') { %>
        <form action="/account/orders/<%= order.id %>/cancel" method="POST" style="margin-top:1rem">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger btn-sm btn-block" onclick="return confirm('Siparişinizi iptal etmek istediğinize emin misiniz? Bu işlem geri alınamaz.')">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:.3rem"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Siparişi İptal Et
          </button>
        </form>
        <% } %>
      </div>

      <% if (order.tracking_url || order.tracking_code || order.cargo_provider) { %>
      <div class="card" style="background:#eff6ff;border-color:#3b82f6">
        <h3 style="color:#1e40af">Kargo Takip</h3>
        <% if (order.cargo_provider) { %>
        <p><strong>Kargo Firması:</strong> <%= order.cargo_provider %></p>
        <% } %>
        <% if (order.tracking_code) { %>
        <p><strong>Takip Kodu:</strong> <code style="background:#dbeafe;padding:2px 8px;border-radius:4px"><%= order.tracking_code %></code></p>
        <% } %>
        <% if (order.tracking_url) { %>
        <a href="<%= order.tracking_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" style="margin-top:.5rem">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:.3rem"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Kargonu Takip Et
        </a>
        <% } %>
      </div>
      <% } %>

      <div class="card">
        <h3>Ödeme Bilgileri</h3>
        <p><strong>Yöntem:</strong> <%= order.payment_method === 'iban' ? 'Havale / EFT' : 'Kredi Kartı' %></p>
        <% 
        const payStatusMap = {
          pending: { text: 'Ödeme Bekleniyor', class: 'warning' },
          awaiting_confirmation: { text: 'Onay Bekleniyor', class: 'info' },
          confirmed: { text: 'Onaylandı', class: 'success' },
          failed: { text: 'Başarısız', class: 'danger' }
        };
        const payStatus = payStatusMap[order.payment_status] || { text: order.payment_status, class: 'secondary' };
        %>
        <p><strong>Durum:</strong> <span class="badge badge-<%= payStatus.class %>"><%= payStatus.text %></span></p>

        <% if (order.payment_method === 'iban' && order.payment_code) { %>
        <div class="iban-box">
          <p><strong>Açıklama Kodu:</strong> <code><%= order.payment_code %></code></p>
          <% if (ibanInfo) { %>
          <p><strong>Banka:</strong> <%= ibanInfo.bank_name || '-' %></p>
          <p><strong>Hesap Sahibi:</strong> <%= ibanInfo.account_holder || '-' %></p>
          <p><strong>IBAN:</strong> <%= ibanInfo.iban || '-' %></p>
          <% } %>
          <% if (order.payment_status === 'pending') { %>
          <form action="/api/checkout/confirm-payment" method="POST" style="margin-top: 1rem">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="order_id" value="<%= order.id %>">
            <button type="submit" class="btn btn-sm btn-primary">Parayı Gönderdim</button>
          </form>
          <% } %>
        </div>
        <% } %>
      </div>

      <% if (shippingAddress) { %>
      <div class="card">
        <h3>Teslimat Adresi</h3>
        <div class="info-list">
          <p><strong><%= shippingAddress.first_name %> <%= shippingAddress.last_name %></strong></p>
          <p><%= shippingAddress.address %></p>
          <p><%= shippingAddress.city %><%= shippingAddress.district ? ' / ' + shippingAddress.district : '' %></p>
          <% if (shippingAddress.zip_code) { %><p>Posta Kodu: <%= shippingAddress.zip_code %></p><% } %>
          <p><%= shippingAddress.country || 'Türkiye' %></p>
          <% if (shippingAddress.phone) { %><p>Tel: <%= shippingAddress.phone %></p><% } %>
        </div>
      </div>
      <% } %>

      <% if (billing) { %>
      <div class="card">
        <h3>Fatura Bilgileri</h3>
        <div class="info-list">
          <% if (billing.type === 'corporate') { %>
          <p><strong><%= billing.company_name %></strong></p>
          <p>Vergi Dairesi: <%= billing.tax_office %> / <%= billing.tax_no %></p>
          <% } else { %>
          <p><strong><%= billing.first_name %> <%= billing.last_name %></strong></p>
          <% if (billing.tc_no) { %><p>TC: <%= billing.tc_no %></p><% } %>
          <% } %>
          <p><%= billing.address %></p>
          <p><%= billing.city %><%= billing.district ? ' / ' + billing.district : '' %></p>
        </div>
      </div>
      <% } %>

      <% if (order.notes) { %>
      <div class="card">
        <h3>Sipariş Notu</h3>
        <p><%= order.notes %></p>
      </div>
      <% } %>

      <% if (order.invoice_url) { %>
      <div class="card" style="background:#f0fdf4;border-color:#22c55e">
        <h3 style="color:#166534">Fatura</h3>
        <a href="<%= order.invoice_url %>" target="_blank" class="btn btn-success btn-sm btn-block">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:.3rem"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          Faturayı İndir (PDF)
        </a>
      </div>
      <% } %>
    </div>
  </div>
</div>
