<% layout('layouts/main') %>

<div class="container page-content">
  <div class="breadcrumb">
    <a href="/">Ana Sayfa</a> &rsaquo; <a href="/blog">Blog</a>
    <% if (post.category_name) { %>
    &rsaquo; <a href="/blog?category=<%= post.category_slug %>"><%= post.category_name %></a>
    <% } %>
    &rsaquo; <span><%= post.title %></span>
  </div>

  <article class="post-detail">
    <header class="post-header">
      <% if (post.category_name) { %>
      <a href="/blog?category=<%= post.category_slug %>" class="post-category"><%= post.category_name %></a>
      <% } %>
      <h1><%= post.title %></h1>
      <div class="post-meta">
        <span class="post-author">
          <% if (post.author_avatar) { %>
          <img src="<%= post.author_avatar %>" alt="" class="avatar-sm">
          <% } %>
          <%= post.author_name || 'Yönetici' %>
        </span>
        <span class="post-date"><%= new Date(post.created_at).toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
        <% if (post.view_count) { %>
        <span class="post-views"><%= post.view_count %> görüntülenme</span>
        <% } %>
      </div>
    </header>

    <% if (post.cover_image) { %>
    <div class="post-cover">
      <img src="<%= post.cover_image %>" alt="<%= post.title %>" loading="lazy">
    </div>
    <% } %>

    <div class="post-content prose">
      <%- post.renderedContent %>
    </div>

    <!-- Paylaş -->
    <div class="post-share">
      <span>Paylaş:</span>
      <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(site.url + '/blog/' + post.slug) %>" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(site.url + '/blog/' + post.slug) %>" target="_blank" rel="noopener noreferrer">Facebook</a>
      <a href="https://www.linkedin.com/shareArticle?mini=true&url=<%= encodeURIComponent(site.url + '/blog/' + post.slug) %>&title=<%= encodeURIComponent(post.title) %>" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(post.title + ' ' + site.url + '/blog/' + post.slug) %>" target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </div>
  </article>

  <!-- İlgili Yazılar -->
  <% if (related && related.length > 0) { %>
  <section class="related-section">
    <h2>İlgili Yazılar</h2>
    <div class="post-grid post-grid-sm">
      <% related.forEach(rp => { %>
      <article class="post-card">
        <a href="/blog/<%= rp.slug %>" class="post-card-image">
          <% if (rp.cover_image) { %>
          <img src="<%= rp.cover_image %>" alt="<%= rp.title %>" loading="lazy">
          <% } else { %>
          <div class="placeholder-image"><svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></div>
          <% } %>
        </a>
        <div class="post-card-body">
          <h3 class="post-card-title"><a href="/blog/<%= rp.slug %>"><%= rp.title %></a></h3>
          <span class="post-date"><%= new Date(rp.created_at).toLocaleDateString('tr-TR') %></span>
        </div>
      </article>
      <% }) %>
    </div>
  </section>
  <% } %>
</div>
