<% layout('layouts/main') %>

<div class="contact-hero">
  <div class="container">
    <h1 class="contact-hero-title">İletişim</h1>
    <p class="contact-hero-sub"><%= site.site_name %> ile iletişime geçin</p>
  </div>
</div>

<div class="container page-content">
  <div class="breadcrumb">
    <a href="/">Ana Sayfa</a> &rsaquo; <span>İletişim</span>
  </div>

  <%
  const methods = contactMethods.length > 0 ? contactMethods : [
    { type: 'email', label: 'E-posta', value: 'info@example.com', icon: '📧' },
    { type: 'phone', label: 'Telefon', value: '+90 212 000 00 00', icon: '📞' },
    { type: 'address', label: 'Adres', value: 'İstanbul, Türkiye', icon: '📍' }
  ];
  %>

  <div class="contact-cards-grid">
    <% methods.forEach(cm => {
      let href = null;
      let svgIcon = '';
      if (cm.type === 'email') {
        href = 'mailto:' + cm.value;
        svgIcon = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>';
      } else if (cm.type === 'phone') {
        href = 'tel:' + cm.value;
        svgIcon = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.02 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>';
      } else if (cm.type === 'whatsapp') {
        href = 'https://wa.me/' + cm.value.replace(/\D/g,'');
        svgIcon = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>';
      } else if (cm.type === 'address') {
        href = null;
        svgIcon = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>';
      } else {
        href = cm.value;
        svgIcon = '<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>';
      }
    %>
    <div class="contact-info-card">
      <div class="contact-card-icon"><%- svgIcon %></div>
      <div class="contact-card-content">
        <span class="contact-card-label"><%= cm.label || cm.type %></span>
        <% if (href) { %>
        <a href="<%= href %>" class="contact-card-value" <% if (cm.type !== 'email' && cm.type !== 'phone') { %>target="_blank" rel="noopener noreferrer"<% } %>><%= cm.value %></a>
        <% } else { %>
        <span class="contact-card-value"><%= cm.value %></span>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <% if (site.social_facebook || site.social_twitter || site.social_instagram || site.social_youtube) { %>
  <div class="contact-social-section">
    <h2 class="contact-social-title">Sosyal Medya</h2>
    <div class="contact-social-links">
      <% if (site.social_facebook) { %>
      <a href="<%= site.social_facebook %>" target="_blank" rel="noopener noreferrer" class="contact-social-btn contact-social-facebook">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        Facebook
      </a>
      <% } %>
      <% if (site.social_twitter) { %>
      <a href="<%= site.social_twitter %>" target="_blank" rel="noopener noreferrer" class="contact-social-btn contact-social-twitter">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
        Twitter
      </a>
      <% } %>
      <% if (site.social_instagram) { %>
      <a href="<%= site.social_instagram %>" target="_blank" rel="noopener noreferrer" class="contact-social-btn contact-social-instagram">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        Instagram
      </a>
      <% } %>
      <% if (site.social_youtube) { %>
      <a href="<%= site.social_youtube %>" target="_blank" rel="noopener noreferrer" class="contact-social-btn contact-social-youtube">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon fill="#fff" points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/></svg>
        YouTube
      </a>
      <% } %>
    </div>
  </div>
  <% } %>

</div>
