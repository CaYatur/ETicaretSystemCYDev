<% layout('layouts/main') %>

<div class="auth-page">
  <div class="auth-card auth-card-sm">
    <h1>Şifre Sıfırla</h1>
    <p class="auth-subtitle">Yeni şifrenizi belirleyin.</p>

    <form action="/auth/reset-password/<%= token %>" method="POST" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label">Yeni Şifre</label>
        <input type="password" name="password" required class="form-input" placeholder="En az 6 karakter" autocomplete="new-password" minlength="6">
      </div>

      <div class="form-group">
        <label class="form-label">Şifre Tekrar</label>
        <input type="password" name="password_confirm" required class="form-input" placeholder="Şifrenizi tekrar girin" autocomplete="new-password" minlength="6">
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">Şifremi Güncelle</button>
    </form>

    <p class="auth-footer">
      <a href="/auth/login" class="link">&larr; Giriş sayfasına dön</a>
    </p>
  </div>
</div>
