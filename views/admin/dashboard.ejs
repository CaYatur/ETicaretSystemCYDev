<% layout('layouts/admin') %>

<h1>Dashboard</h1>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.98-1.71l1.6-9.29H6"/></svg></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.totalOrders || 0 %></span>
      <span class="stat-label">Toplam Sipariş</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></div>
    <div class="stat-info">
      <span class="stat-number"><%= site.currency_symbol %><%= (stats.totalRevenue || 0).toFixed(2) %></span>
      <span class="stat-label">Toplam Gelir</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.totalUsers || 0 %></span>
      <span class="stat-label">Kullanıcı</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.totalProducts || 0 %></span>
      <span class="stat-label">Ürün</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.totalPosts || 0 %></span>
      <span class="stat-label">Blog Yazısı</span>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></div>
    <div class="stat-info">
      <span class="stat-number"><%= stats.todayVisits || 0 %></span>
      <span class="stat-label">Bugünkü Ziyaret</span>
    </div>
  </div>
</div>

<!-- Son Siparişler -->
<div class="admin-card">
  <div class="admin-card-header">
    <h2>Son Siparişler</h2>
    <a href="/admin/orders" class="btn btn-sm btn-outline">Tümünü Gör</a>
  </div>
  <% if (recentOrders && recentOrders.length > 0) { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Sipariş No</th>
        <th>Müşteri</th>
        <th>Toplam</th>
        <th>Durum</th>
        <th>Ödeme</th>
        <th>Tarih</th>
      </tr>
    </thead>
    <tbody>
      <% recentOrders.forEach(order => { %>
      <tr>
        <td><a href="/admin/orders/<%= order.id %>">#<%= order.order_number %></a></td>
        <td><%= order.user_name || order.user_email %></td>
        <td><%= site.currency_symbol %><%= order.total.toFixed(2) %></td>
        <td>
          <% const statusClasses = { pending: 'warning', paid: 'info', processing: 'info', shipped: 'primary', delivered: 'success', cancelled: 'danger' }; %>
          <% const statusTexts = { pending: 'Beklemede', paid: 'Ödendi', processing: 'Hazırlanıyor', shipped: 'Kargoda', delivered: 'Teslim', cancelled: 'İptal' }; %>
          <span class="badge badge-<%= statusClasses[order.status] || 'secondary' %>"><%= statusTexts[order.status] || order.status %></span>
        </td>
        <td>
          <% const payClasses = { pending: 'warning', awaiting_confirmation: 'info', confirmed: 'success', failed: 'danger' }; %>
          <span class="badge badge-<%= payClasses[order.payment_status] || 'secondary' %>"><%= order.payment_status %></span>
        </td>
        <td><%= new Date(order.created_at).toLocaleDateString('tr-TR') %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <p class="text-muted text-center" style="padding:2rem">Henüz sipariş yok</p>
  <% } %>
</div>

<!-- Ziyaret Grafiği -->
<div class="admin-card">
  <div class="admin-card-header">
    <h2>Son 7 Gün Ziyaretler</h2>
    <a href="/admin/analytics" class="btn btn-sm btn-outline">Detaylı Analiz</a>
  </div>
  <div class="chart-container">
    <div class="simple-chart" id="visitChart">
      <% if (typeof visitData !== 'undefined' && visitData && visitData.length > 0) { %>
      <% const maxVisit = Math.max(...visitData.map(v => v.count), 1); %>
      <% visitData.forEach(v => { %>
      <div class="chart-bar-wrap">
        <div class="chart-bar" style="height: <%= (v.count / maxVisit * 100) %>%" title="<%= v.date %>: <%= v.count %> ziyaret">
          <span class="chart-bar-label"><%= v.count %></span>
        </div>
        <span class="chart-bar-date"><%= new Date(v.date).toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit' }) %></span>
      </div>
      <% }) %>
      <% } else { %>
      <p class="text-muted text-center">Henüz veri yok</p>
      <% } %>
    </div>
  </div>
</div>
